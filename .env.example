# Persistent storage. Add an Upstash Redis integration in Vercel, then copy its values here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta / Instagram API. The account must be a Professional Creator or Business account.
# This default uses Meta's current direct Instagram Login flow. Generate the token
# from the Instagram API setup page in your Meta app dashboard.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_MODE=instagram-login
META_GRAPH_API_VERSION=v24.0

# Only needed if you deliberately use Meta's older Facebook Login / Page-token route.
# INSTAGRAM_API_MODE=facebook-login
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Google OAuth. Add http://localhost:3000/api/google/callback and your production
# domain followed by /api/google/callback as authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
