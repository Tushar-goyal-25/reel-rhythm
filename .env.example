# Persistent storage. On Vercel, adding the Upstash Redis integration creates
# KV_REST_API_URL and KV_REST_API_TOKEN for you and nothing below needs setting: the
# app reads that pair when the UPSTASH_ names are absent or blank. Leave these two
# commented out rather than adding them empty alongside the integration's variables.
#
# Set them only outside Vercel. Both must be the HTTPS REST endpoint and its token,
# not a rediss:// connection string, so REDIS_URL and KV_URL are never used here.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Meta / Instagram API. The account must be a Professional Creator or Business account.
# This default uses Meta's current direct Instagram Login flow. Generate the token
# from the Instagram API setup page in your Meta app dashboard.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_MODE=instagram-login
META_GRAPH_API_VERSION=v24.0

# Sync reach. The media edge returns one page at a time, so the sync follows the
# paging cursors to keep older reels updating rather than freezing at the numbers
# they last had. Each reel costs one insights call, so these bound the work: raise
# INSTAGRAM_MAX_REELS if your library is larger, lower the concurrency if Meta
# starts rate limiting. The edge itself exposes at most 10K media.
# INSTAGRAM_PAGE_SIZE=100
# INSTAGRAM_MAX_REELS=300
# INSTAGRAM_INSIGHT_CONCURRENCY=6

# Only needed if you deliberately use Meta's older Facebook Login / Page-token route.
# INSTAGRAM_API_MODE=facebook-login
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Google OAuth. Add http://localhost:3000/api/google/callback and your production
# domain followed by /api/google/callback as authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
