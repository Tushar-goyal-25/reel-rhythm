# Persistent storage. Add an Upstash Redis integration in Vercel, then copy its values here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta / Instagram Graph API. The Instagram account must be a Professional account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v24.0

# Google OAuth. Add http://localhost:3000/api/google/callback and your production
# domain followed by /api/google/callback as authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
